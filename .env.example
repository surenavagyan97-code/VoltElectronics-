# Copy to .env and fill in real values. Never commit .env.

# MSSQL sa password (must satisfy SQL Server complexity rules)
MSSQL_SA_PASSWORD=VoltDev!Passw0rd

# JWT signing key — at least 32 characters, random
JWT_KEY=change-me-to-a-long-random-string-0123456789abcdef

# Payment gateway: "Fake" (built-in dev gateway, no credentials needed)
# or "Ameria" (Ameriabank vPOS — request test credentials at vpos@ameriabank.am)
PAYMENTS_PROVIDER=Fake

# Ameriabank vPOS credentials (only needed when PAYMENTS_PROVIDER=Ameria)
# Test environment: https://servicestest.ameriabank.am/VPOS
AMERIA_BASE_URL=https://servicestest.ameriabank.am/VPOS
AMERIA_CLIENT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
# Must match your vPOS merchant account currency: AMD | USD | EUR | RUB
AMERIA_CURRENCY=USD
# Test merchants get a numeric OrderID range from the bank; offset shifts our order ids into it
AMERIA_ORDER_ID_OFFSET=0

# Public URL of the API (the bank redirects the shopper back here after payment)
PAYMENTS_CALLBACK_BASE_URL=http://localhost:8080
# Where shoppers land after the callback is processed
PAYMENTS_FRONTEND_BASE_URL=http://localhost

# Seeded admin account (admin@volt.local)
ADMIN_PASSWORD=Admin123$
